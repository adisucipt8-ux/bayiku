<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/w_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bayiku"
        android:textColor="#2F7F73"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buka aplikasi untuk mulai"
        android:textColor="#1D2B2A"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#6B7B79"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/w_left"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn"
            android:text="Kiri"
            android:textAllCaps="false"
            android:textColor="#3A1D0F"
            android:textSize="13sp" />

        <Button
            android:id="@+id/w_right"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn"
            android:text="Kanan"
            android:textAllCaps="false"
            android:textColor="#3A1D0F"
            android:textSize="13sp" />

        <Button
            android:id="@+id/w_diaper"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn2"
            android:text="Popok"
            android:textAllCaps="false"
            android:textColor="#2F7F73"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
